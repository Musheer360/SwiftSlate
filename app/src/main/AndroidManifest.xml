<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".SwiftSlateApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SwiftSlate"
        tools:targetApi="33">
        
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.SwiftSlate">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            Text-selection entry point. No android:label: it would only repeat the application
            label the popup already falls back to. All three filter elements are required: an
            implicit intent needs category.DEFAULT. text/* also covers hosts that offer
            rich-text selections.
        -->
        <activity
            android:name=".ui.processtext.ProcessTextActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.SwiftSlate.Dialog">
            <intent-filter>
                <action android:name="android.intent.action.PROCESS_TEXT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/*" />
            </intent-filter>
            <!--
                Package-visibility workaround, not a link handler.

                Some editors query ACTION_PROCESS_TEXT handlers themselves but never declare a
                matching <queries> element, so on Android 11+ they cannot see this package at
                all and SwiftSlate silently misses from their selection menu. Gmail is the
                worked example: its manifest declares <queries> for VIEW/BROWSABLE/https but
                not for PROCESS_TEXT, so matching that filter is what makes this package
                visible to it — verified with `dumpsys package com.google.android.gm`.

                Deliberately without category.DEFAULT: visibility matching only needs the
                action/category/scheme to line up with the host's declared query, while leaving
                DEFAULT off keeps this activity out of implicit VIEW resolution, so it never
                appears as an https link handler. Confirmed with
                `cmd package query-activities -a VIEW -d https://example.com`, which returns no
                match for this package.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
            </intent-filter>
        </activity>

        <!--
            Bridge between the LSPosed hook (running inside the keyboard app) and this app.
            Exported because the caller lives in another uid; every message must carry the
            per-install token that only hooked processes can read (see ModuleBridge.token).
            Replaces the former AccessibilityService, which is no longer declared.
        -->
        <service
            android:name=".service.HookBridgeService"
            android:exported="true">
            <intent-filter>
                <action android:name="${applicationId}.BRIDGE" />
            </intent-filter>
        </service>

        <!-- LSPosed module registration (the authoritative descriptors are in META-INF/xposed) -->
        <meta-data
            android:name="xposedmodule"
            android:value="true" />
        <meta-data
            android:name="xposeddescription"
            android:value="Run SwiftSlate trigger commands inside your keyboard, without the accessibility service." />
        <meta-data
            android:name="xposedminversion"
            android:value="100" />
    </application>

</manifest>